# Application
APP_NAME=YouTube Analytics
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=youtube_analytics
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=youtube_analytics
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Celery
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/0

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_QUOTA_LIMIT=10000
YOUTUBE_API_QUOTA_RESET_HOUR=0  # Hour when quota resets (0-23 in Pacific Time)

# Rate Limiting
YOUTUBE_API_REQUESTS_PER_SECOND=100
YOUTUBE_API_REQUESTS_PER_DAY=10000

# Cache TTL (seconds)
CACHE_TTL_CHANNEL_DETAILS=3600      # 1 hour
CACHE_TTL_VIDEO_DETAILS=3600        # 1 hour
CACHE_TTL_VIDEO_STATS=1800          # 30 minutes
CACHE_TTL_CHANNEL_STATS=1800        # 30 minutes
CACHE_TTL_COMMENTS=7200             # 2 hours

# Task Schedule
UPDATE_STATS_CRON_HOUR=2            # Hour to run daily stats update (0-23)
CHECK_ALERTS_INTERVAL_MINUTES=30    # How often to check alerts

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your_secret_key_here_please_change_this
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Future features (placeholders)
ENABLE_AI_FEATURES=false
AI_API_KEY=
AI_MODEL_NAME=
