# Application Configuration
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration (SQLite for MVP - can upgrade to PostgreSQL)
DATABASE_URL=sqlite:///./youtube_analytics.db

# YouTube API Configuration (REQUIRED)
# Multiple keys supported - separate with commas for better quota management
# Get keys from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEYS=your-youtube-api-key-1,your-youtube-api-key-2
YOUTUBE_API_QUOTA_LIMIT=10000

# Cache TTL (seconds)
CACHE_TTL_CHANNEL=3600
CACHE_TTL_VIDEO=3600
CACHE_TTL_STATS=21600

# Snapshot Collection Schedule (cron format: minute hour day month day_of_week)
# Default: "0 2 * * *" = Daily at 2:00 AM
SNAPSHOT_SCHEDULE_CRON=0 2 * * *

# Logging
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
# Add your frontend URL here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
