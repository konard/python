# Application Configuration
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/youtube_analytics

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration (optional, defaults to REDIS_URL)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# YouTube API Configuration
# Multiple API keys supported (comma-separated) for quota management and rotation
# Example: YOUTUBE_API_KEYS=key1,key2,key3
YOUTUBE_API_KEYS=your-youtube-api-key-here
YOUTUBE_API_QUOTA_LIMIT=10000

# Cache TTL (seconds)
CACHE_TTL_CHANNEL=3600
CACHE_TTL_VIDEO=3600
CACHE_TTL_STATS=21600

# Snapshot Collection
SNAPSHOT_DEFAULT_SCHEDULE=0 2 * * *

# Logging
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
